{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Clang, for this machine",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows, cross-built with llvm-mingw",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres"
      }
    },
    {
      "name": "linux-ppc64-base",
      "hidden": true,
      "inherits": "base",
      "description": "A Linux PowerPC64 cross build: SNX_SYSROOT names a sysroot from scripts/ppc64-sysroot.sh, whose pkg-config files the libraries are found by",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_NM": "llvm-nm",
        "CMAKE_SYSROOT": "$env{SNX_SYSROOT}",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "ONLY",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld",
        "SNX_LLVM_CONFIG": "${sourceDir}/scripts/ppc64-llvm-config.sh",
        "SNX_DEPLOY": "OFF"
      }
    },
    {
      "name": "linux-ppc64le-cross",
      "displayName": "Linux ppc64le (ELFv2), cross-built with Clang",
      "inherits": "linux-ppc64-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/powerpc64le-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64le",
        "CMAKE_C_COMPILER_TARGET": "powerpc64le-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64le-linux-gnu",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64le;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-ppc64-cross",
      "displayName": "Linux ppc64 big-endian with glibc (ELFv1, Debian ports), cross-built with Clang",
      "inherits": "linux-ppc64-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/powerpc64-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64",
        "CMAKE_C_COMPILER_TARGET": "powerpc64-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64-linux-gnu",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-ppc64-musl-cross",
      "displayName": "Linux ppc64 big-endian with musl (ELFv2), cross-built with Clang",
      "inherits": "linux-ppc64-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64",
        "CMAKE_C_COMPILER_TARGET": "powerpc64-linux-musl",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64-linux-musl",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS on Apple silicon, Xcode's Clang (docs/APPLE.md)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-macos13.0",
        "SNX_BUILD_GNUABI": "OFF"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS, cross-built on a Mac with Xcode (docs/APPLE.md); LLVM_DIR names scripts/apple-llvm.sh's",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_SYSTEM_PROCESSOR": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-ios16.0",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_DISABLE_FIND_PACKAGE_SDL3": "ON",
        "SNX_DEPLOY": "OFF",
        "SNX_BUILD_GNUABI": "OFF",
        "SNX_BUILD_3DS": "OFF",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    },
    {
      "name": "linux-ppc64le-cross",
      "configurePreset": "linux-ppc64le-cross"
    },
    {
      "name": "linux-ppc64-cross",
      "configurePreset": "linux-ppc64-cross"
    },
    {
      "name": "linux-ppc64-musl-cross",
      "configurePreset": "linux-ppc64-musl-cross"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "ios",
      "configurePreset": "ios"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ppc64le-cross",
      "configurePreset": "linux-ppc64le-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    },
    {
      "name": "linux-ppc64-cross",
      "configurePreset": "linux-ppc64-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    },
    {
      "name": "linux-ppc64-musl-cross",
      "configurePreset": "linux-ppc64-musl-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    }
  ]
}
